# Variables para los ejercicios opcionales de Docker Hub (cuaderno 06).
# En GitHub Codespaces, defínalas como secretos de Codespaces con estos mismos
# nombres. En un equipo propio, copie este archivo a .env y escriba los valores.
# El archivo .env no se sube al repositorio.
#
# Nombre de usuario de su cuenta de Docker Hub.
DOCKERHUB_USER=
# Token de acceso personal de Docker Hub (no la contraseña de la cuenta).
DOCKERHUB_TOKEN=
